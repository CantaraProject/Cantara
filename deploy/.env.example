# Settings of a Cantara server. Copy to `.env` beside docker-compose.yml.
# Only the lines without a default have to be filled in.

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=cantara
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cantara

# ── The server ───────────────────────────────────────────────────────────────
# What the server is called on its pages and in the programs.
CANTARA_SERVER_NAME=Cantara
# The address people reach the server at, without a trailing slash. Links in
# invitations and shared presentations start with it, and logins through an
# OpenID Connect provider come back to it. Cookies are only sent over HTTPS
# when this starts with https://.
CANTARA_PUBLIC_URL=http://localhost:8080
# The port on the host (docker compose only).
CANTARA_PORT=8080
# Where the files are kept on the host: a directory (/srv/cantara/files), or
# empty for a Docker volume.
CANTARA_DATA=
# The largest file accepted, in bytes. Default: 2 GiB.
#CANTARA_MAX_UPLOAD_BYTES=2147483648
# How long a browser stays logged in after its last visit, in days.
#CANTARA_SESSION_DAYS=30
# `info`, `debug`, … and per module: `info,cantara_server=debug`.
#RUST_LOG=info

# ── Organisations ────────────────────────────────────────────────────────────
# One organisation (a congregation) per server — the usual case. Set to false
# to host several; a server administrator then creates them.
CANTARA_SINGLE_TENANT=true
# The name of that one organisation, on first start.
CANTARA_TENANT_NAME=Gemeinde

# ── Accounts ─────────────────────────────────────────────────────────────────
# The first administrator, created on the very first start only. Log in and
# change the password afterwards; the variables can stay.
CANTARA_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
CANTARA_BOOTSTRAP_ADMIN_PASSWORD=change-me-too
# Whether people may create an account without being invited.
CANTARA_ALLOW_REGISTRATION=false
# Whether accounts with a password exist at all. Set to false where everybody
# logs in through an OpenID Connect provider.
CANTARA_PASSWORD_LOGIN=true

# ── OpenID Connect ───────────────────────────────────────────────────────────
# Comma-separated short names; each needs the variables below with its name
# in capitals. The redirect URI to register with the provider is
# ${CANTARA_PUBLIC_URL}/auth/oidc/callback.
#CANTARA_OIDC_PROVIDERS=keycloak
#CANTARA_OIDC_KEYCLOAK_NAME=Gemeinde-Login
#CANTARA_OIDC_KEYCLOAK_ISSUER=http://keycloak:8080/realms/cantara
#CANTARA_OIDC_KEYCLOAK_CLIENT_ID=cantara-server
#CANTARA_OIDC_KEYCLOAK_CLIENT_SECRET=
