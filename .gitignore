# Generated by Cargo
# will have compiled files and executables
/target
.DS_Store
/node_modules
/release

# Bundled repositories cloned during CI for WASM builds
/bundled_repos

# These are backup files generated by rustfmt
**/*.rs.bk

# Idea config files
.idea/
.claude/
# The browser tests' output. The report is worth reading when something fails
# and worth nothing afterwards; CI keeps it as an artifact instead.
/playwright-report
/test-results
/.playwright
